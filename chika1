```html
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Institute of Management and Technology | IMT Enugu</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    scroll-behavior:smooth;
}

body{
    font-family:Arial, Helvetica, sans-serif;
    line-height:1.6;
    color:#222;
    background:#fff;
}

/* TOP BAR */
.topbar{
    background:#071f4d;
    color:#fff;
    padding:8px 7%;
    display:flex;
    justify-content:space-between;
    font-size:14px;
}

/* HEADER */
header{
    background:#fff;
    padding:15px 7%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    position:sticky;
    top:0;
    z-index:1000;
    box-shadow:0 3px 15px rgba(0,0,0,.12);
}

.logo{
    display:flex;
    align-items:center;
    gap:12px;
}

.logo-mark{
    width:55px;
    height:55px;
    border-radius:50%;
    background:#0b4ea2;
    color:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:bold;
    font-size:18px;
}

.logo-text{
    color:#071f4d;
    font-weight:900;
    font-size:18px;
    line-height:1.15;
}

.logo-text span{
    color:#d71920;
}

nav ul{
    display:flex;
    list-style:none;
    gap:25px;
}

nav a{
    text-decoration:none;
    color:#071f4d;
    font-weight:bold;
}

nav a:hover{
    color:#d71920;
}

.menu{
    display:none;
    font-size:28px;
    cursor:pointer;
    color:#071f4d;
}

/* HERO */
.hero{
    min-height:620px;
    display:flex;
    align-items:center;
    padding:70px 7%;
    color:white;

    background:
    linear-gradient(
        rgba(7,31,77,.82),
        rgba(7,31,77,.70)
    ),
    url("https://images.unsplash.com/photo-1562774053-701939374585?auto=format&fit=crop&w=1800&q=80");

    background-size:cover;
    background-position:center;
}

.hero-content{
    max-width:780px;
}

.hero h1{
    font-size:58px;
    line-height:1.1;
    margin-bottom:20px;
}

.hero h1 span{
    color:#f5c400;
}

.hero p{
    font-size:20px;
    margin-bottom:30px;
}

.btn{
    display:inline-block;
    padding:14px 28px;
    border-radius:6px;
    text-decoration:none;
    font-weight:bold;
    margin:5px;
    transition:.3s;
}

.btn-primary{
    background:#d71920;
    color:white;
}

.btn-primary:hover{
    background:#f5c400;
    color:#071f4d;
}

.btn-gold{
    background:#f5c400;
    color:#071f4d;
}

.btn-gold:hover{
    background:#fff;
}

/* GENERAL */
section{
    padding:75px 7%;
}

.section-title{
    text-align:center;
    margin-bottom:45px;
}

.section-title h2{
    color:#071f4d;
    font-size:40px;
}

.section-title p{
    color:#666;
    margin-top:8px;
}

/* QUICK ACTIONS */
.actions{
    margin-top:-45px;
    position:relative;
    z-index:5;
}

.action-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:20px;
}

.action{
    background:#fff;
    padding:25px;
    text-align:center;
    border-radius:10px;
    box-shadow:0 5px 25px rgba(0,0,0,.12);
}

.action h3{
    color:#071f4d;
    margin-bottom:10px;
}

.action a{
    color:#d71920;
    text-decoration:none;
    font-weight:bold;
}

/* ABOUT */
.about{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:50px;
    align-items:center;
    background:#f5f7fb;
}

.about-image img{
    width:100%;
    border-radius:14px;
}

.about-text h2{
    font-size:40px;
    color:#071f4d;
    margin-bottom:20px;
}

.about-text p{
    color:#555;
    margin-bottom:18px;
}

.check{
    margin:12px 0;
    font-weight:bold;
    color:#071f4d;
}

/* PROGRAMMES */
.programme-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:22px;
}

.programme{
    padding:30px 22px;
    border-radius:12px;
    background:#fff;
    box-shadow:0 5px 20px rgba(0,0,0,.08);
    border-top:5px solid #0b4ea2;
    transition:.3s;
}

.programme:hover{
    transform:translateY(-8px);
}

.programme .icon{
    font-size:42px;
    margin-bottom:15px;
}

.programme h3{
    color:#071f4d;
    margin-bottom:10px;
}

/* STATS */
.stats{
    background:#071f4d;
    color:#fff;
    display:grid;
    grid-template-columns:repeat(4,1fr);
    text-align:center;
    gap:20px;
}

.stat h2{
    color:#f5c400;
    font-size:40px;
}

.stat p{
    font-weight:bold;
}

/* ADMISSIONS */
.admission{
    background:
    linear-gradient(
        rgba(11,78,162,.92),
        rgba(7,31,77,.92)
    ),
    url("https://images.unsplash.com/photo-1523050854058-8df90110c9f1?auto=format&fit=crop&w=1600&q=80");

    background-size:cover;
    color:#fff;
    text-align:center;
}

.admission h2{
    font-size:42px;
    margin-bottom:15px;
    color:#f5c400;
}

.admission p{
    max-width:800px;
    margin:auto;
}

/* CAMPUS */
.campus{
    background:#f5f7fb;
}

.campus-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:25px;
}

.campus-card{
    background:#fff;
    border-radius:12px;
    overflow:hidden;
    box-shadow:0 5px 20px rgba(0,0,0,.08);
}

.campus-card img{
    width:100%;
    height:220px;
    object-fit:cover;
}

.campus-content{
    padding:25px;
}

.campus-content h3{
    color:#071f4d;
    margin-bottom:10px;
}

/* NEWS */
.news-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:25px;
}

.news-card{
    border-radius:12px;
    overflow:hidden;
    background:#fff;
    box-shadow:0 5px 20px rgba(0,0,0,.08);
}

.news-card img{
    width:100%;
    height:200px;
    object-fit:cover;
}

.news-content{
    padding:22px;
}

.news-content h3{
    color:#071f4d;
    margin-bottom:10px;
}

.news-date{
    color:#d71920;
    font-size:14px;
    font-weight:bold;
}

/* CONTACT */
.contact{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:50px;
}

.contact h2{
    color:#071f4d;
    font-size:40px;
    margin-bottom:20px;
}

.contact-info p{
    margin:15px 0;
}

.contact-form{
    background:#f5f7fb;
    padding:30px;
    border-radius:12px;
}

.contact-form input,
.contact-form select,
.contact-form textarea{
    width:100%;
    padding:14px;
    margin-bottom:15px;
    border:1px solid #ddd;
    border-radius:6px;
    font-size:16px;
}

.contact-form textarea{
    height:130px;
    resize:vertical;
}

.contact-form button{
    border:none;
    cursor:pointer;
    width:100%;
}

/* FOOTER */
footer{
    background:#061936;
    color:#fff;
    padding:55px 7% 20px;
}

.footer-grid{
    display:grid;
    grid-template-columns:2fr 1fr 1fr 1fr;
    gap:40px;
    margin-bottom:35px;
}

footer h3{
    color:#f5c400;
    margin-bottom:15px;
}

footer ul{
    list-style:none;
}

footer li{
    margin:8px 0;
}

footer a{
    color:#ddd;
    text-decoration:none;
}

footer a:hover{
    color:#f5c400;
}

.copyright{
    border-top:1px solid rgba(255,255,255,.2);
    padding-top:20px;
    text-align:center;
    color:#aaa;
}

/* MOBILE */
@media(max-width:900px){

    nav ul{
        display:none;
        position:absolute;
        top:85px;
        left:0;
        width:100%;
        background:#fff;
        flex-direction:column;
        padding:25px 7%;
        box-shadow:0 5px 15px rgba(0,0,0,.15);
    }

    nav ul.active{
        display:flex;
    }

    .menu{
        display:block;
    }

    .hero h1{
        font-size:43px;
    }

    .action-grid,
    .programme-grid,
    .campus-grid,
    .news-grid{
        grid-template-columns:1fr 1fr;
    }

    .about,
    .contact{
        grid-template-columns:1fr;
    }

    .stats{
        grid-template-columns:1fr 1fr;
    }

    .footer-grid{
        grid-template-columns:1fr 1fr;
    }
}

@media(max-width:550px){

    .topbar{
        display:none;
    }

    .hero{
        min-height:560px;
    }

    .hero h1{
        font-size:35px;
    }

    .hero p{
        font-size:17px;
    }

    .action-grid,
    .programme-grid,
    .campus-grid,
    .news-grid,
    .stats,
    .footer-grid{
        grid-template-columns:1fr;
    }

    section{
        padding:60px 5%;
    }
}
</style>
</head>

